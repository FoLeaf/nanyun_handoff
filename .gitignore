# Handoff repository safety rules
# Credentials and local secrets
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ovpn
*.kdbx
**/*secret*
**/*token*
**/*password*
**/*passwd*
**/*credential*
**/*私钥*
**/*密钥*
**/*密码*
**/*账号*
**/*凭证*

# Local metadata / caches / build output
.git/
.opencode/
.trellis/
tmp/
**/.git/
**/.cache/
**/node_modules/
**/__pycache__/
**/build/
**/out/
**/dist/
**/target/
**/Obj/
**/List/
**/Debug/
**/Release/
**/*_backup/
**/*backup*/
**/*chrome-profile*/
**/*cdp-profile*/

# Common generated artifacts
*.o
*.obj
*.elf
*.axf
*.bin
*.hex
*.map
*.lib
*.dll
*.exe
*.pyc
*.log
